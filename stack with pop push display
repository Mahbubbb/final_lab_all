#include <iostream>
using namespace std;
int n;
int stack[100];
int top= -1;
void push(int value){
    if(top<n-1){
        top++;
        stack[top]=value;
    }
    else{
        cout<<"Stack Overflow";
    }
}
void pop(){
    if(top==-1){
        cout<<"Empty Stack";
    }
    else{
        cout<<stack[top]<<" is being deleted\n";
        top--;
    }
}
void display(){
    for(int i=top;i>=0;i--){
        cout<<stack[i]<<" ";
    }
}
int main(){
    cin>>n;
    push(10);
    push(20);
    push(30);
    push(40);
    display();
    pop();
    display();
    return 0;
}
